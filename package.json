{
  "name": "max-height",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "description": "Max Height — interactive AI character web experience",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "validate": "eslint . && prettier --check . && tsc --build && pnpm -r --if-present build && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "overrides": {
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
