{
  "name": "max-height",
  "version": "0.1.0",
  "private": true,
  "description": "Max Height — interactive AI character web experience",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@eslint/js": "^9.27.0",
    "typescript-eslint": "^8.33.0",
    "eslint": "^9.27.0",
    "prettier": "^3.5.0"
  },
  "overrides": {
    "zod": "^4.3.6",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
