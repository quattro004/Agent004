{
  "name": "@max-height/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1175.0",
    "@aws-sdk/client-bedrock-runtime": "3.1175.0",
    "@aws-sdk/client-dynamodb": "3.1175.0",
    "@aws-sdk/client-polly": "3.1175.0",
    "@aws-sdk/client-ssm": "3.1175.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "0.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@strands-agents/sdk": "1.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.1.1"
  }
}
