{
  "name": "@max-height/repo-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository hygiene tooling — wiki linting and related checks",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "wiki:lint": "tsx bin/wiki-lint.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
