# Normalize all text files to LF in the repository and in the working tree.
# Prettier's `endOfLine` default is "lf", so without this a Windows clone
# (git core.autocrlf=true) checks out CRLF and `pnpm run format:check` fails
# on every tracked text file while Linux CI passes.
* text=auto eol=lf

# Shell scripts must keep LF or they break when executed.
*.sh text eol=lf

# Windows-only scripts are more predictable with CRLF.
*.ps1 text eol=crlf

# Exception: Spec Kit records a SHA-256 of every file it manages and writes its
# PowerShell scripts with LF. Checking them out as CRLF changes the bytes, so
# `specify integration status` reports them as modified when they are untouched
# — and the documented remedy for that warning is `--force`, which overwrites
# real customizations elsewhere. Keep these LF so the integrity check stays true.
.specify/scripts/powershell/*.ps1 text eol=lf

# Binary assets: never touch line endings or attempt text diffs.
*.png binary
*.ico binary
*.mp3 binary
